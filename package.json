{
  "name": "eofol6",
  "version": "0.0.1",
  "scripts": {
    "start": "node ./scripts/start.cjs",
    "dev": "npm run start",
    "build": "node ./scripts/build.cjs",
    "serve": "node ./scripts/serve.cjs",
    "clean": "node ./scripts/clean.cjs",
    "analyze": "npm start -- --analyze",
    "reinstall": "node ./scripts/reinstall.cjs",
    "reinstall-f": "node ./scripts/reinstall.cjs -f",
    "check": "npx eslint -c eslint.config.mjs .",
    "check-fix": "npx eslint -c eslint.config.mjs --fix .",
    "prettify": "npx prettier . --write",
    "lint": "npm run check-fix && npm run prettify",
    "deploy": "node ./scripts/deploy.cjs",
    "release": "npm run build && npm run deploy",
    "lighthouse": "node ./scripts/lighthouse.cjs",
    "depcheck": "npx depcheck",
    "docker-build": "docker build -t eofol6-test ./docker",
    "docker-run": "docker run -p 8080:8080 eofol6-test",
    "docker-stop": "bash ./docker/docker-stop.sh",
    "docker-test": "npm run docker-stop && npm run docker-build && npm run docker-run"
  },
  "author": "Jakub Eliáš <wurducius@gmail.com>",
  "license": "MIT",
  "description": "All inclusive web framework with zero configuration, batteries included!",
  "dependencies": {
    "chalk": "4.1.2",
    "dotenv": "17.2.1",
    "dotenv-webpack": "8.1.1",
    "eofol-runtime": "0.0.1",
    "eofol-sx": "0.1.0",
    "eofol-webpack-plugin": "0.0.6",
    "http-server": "14.1.1",
    "rimraf": "6.0.1",
    "ts-loader": "9.5.2",
    "typescript": "5.9.2",
    "webpack": "5.101.0",
    "webpack-bundle-analyzer": "4.10.2",
    "webpack-dev-server": "5.2.2"
  },
  "devDependencies": {
    "@eslint/js": "9.32.0",
    "eslint": "9.32.0",
    "globals": "16.3.0",
    "open": "10.2.0",
    "prettier": "3.6.2",
    "typescript-eslint": "8.39.0"
  }
}
